-- Boss monster for a dynamic dungeon instance. Extends Monster (HP, hit handling, respawn
-- settings) and adds start/finish effects; when it dies, the dynamic map it lives in is closed
-- via SceneManager and everyone inside is sent to returnMapOnDefeat.
@Component
script InstanceDungeonMonster extends Monster

	-- Static map name players are teleported to when the boss is defeated
	property string returnMapOnDefeat = ""

	-- Overrides Monster.Dead: same DEAD state + delayed hide, but never destroys the entity
	-- (the whole dynamic map is destroyed instead), then starts the finish sequence.
	-- Server-only because it is called from Monster.HandleHitEvent on the server.
	@ExecSpace("ServerOnly")
	method void Dead()
		self.IsDead = true
		local stateComponent = self.Entity.StateComponent
		if stateComponent then
			stateComponent:ChangeState("DEAD")
			log("monster change state to DEAD")
		end
		
		local delayHide = function()
			self.Entity:SetVisible(false)
			self.Entity:SetEnable(false)
		end
		
		_TimerService:SetTimerOnce(delayHide, self.DestroyDelay)
		-- Client method called from the server: runs on every client in the map
		self:BossFinish()
		
	end

	-- Initializes HP via Monster.OnBeginPlay, then plays the boss start effect.
	-- No ExecSpace, so this runs on both server and client.
	method void OnBeginPlay()
		__base:OnBeginPlay()
		self:BossStart()
	end

	-- Plays the encounter-start effect 2 units above the boss.
	@ExecSpace("Client")
	method void BossStart()
		_EffectService:PlayEffect("eee4571f66ff4acf8b7f3878860642fa", self.Entity, self.Entity.TransformComponent.Position + Vector3.up * 2, 0, Vector3.one)
	end

	-- Plays the defeat effect, then after DestroyDelay * 2 seconds asks SceneManager (a Server
	-- method) to close this dynamic map and send its players to returnMapOnDefeat.
	@ExecSpace("Client")
	method void BossFinish()
		_EffectService:PlayEffect("ad24ef5bcf8448fa9713a868aff14d6d", self.Entity, self.Entity.TransformComponent.Position + Vector3.up * 2, 0, Vector3.one)
		_TimerService:SetTimerOnce(function() 
			-- The map's Name is the dynamic instance name (e.g. "<mapName>_1")
			local mapName = self.Entity.CurrentMap.Name
			_SceneManager:CloseDynamicMap(mapName, self.returnMapOnDefeat)
		end, self.DestroyDelay * 2)
		
	end

end