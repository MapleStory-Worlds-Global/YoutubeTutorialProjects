-- Global table of sound-effect RUIDs, accessed as _SFXList.<NAME> and passed to
-- _SoundManager.PlaySFX / PlaySFXAtPos. Keeps resource IDs in one place instead of
-- hard-coding them across scripts.
@Logic
script SFXList extends Logic

	-- Played at a player's position when they become the Zakum (ZakumPlayerComponent.SetZakum)
	property string STEALZAKUM = "e6a3b57a2cb04718aafcfc3aef3e0b90"

	-- Played when a round ends and the winner is decided (GameManager.GameEnd)
	property string WINNER = "401ca227c0c844569422a53bd21ab647"

	-- Played when a round starts (GameManager.GameStart)
	property string START = "c27eff42e89b4781a6f9e5d7d446dd31"

	-- Played on every countdown tick (GameManager.BeginCountdown)
	property string COUNT = "449f5f8be2a0485b907b9bd0579d1701"

	-- Played at a player's position when they take the portal into the game area
	-- (GameManager.TeleportToStartingArea)
	property string PORTAL = "bcc51ef9cf164d8ba10851c4889a35ae"

end