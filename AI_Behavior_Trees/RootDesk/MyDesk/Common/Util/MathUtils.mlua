-- Global math helper singleton (accessed as _MathUtils): 2D point rotation and cheap
-- distance functions used by gameplay scripts such as BossProjectile.
@Logic
script MathUtils extends Logic

	-- Scales `point` by the transform's Scale and rotates it by its ZRotation (degrees) using a
	-- standard 2D rotation matrix. Returns the resulting offset (translation is not applied).
	method Vector2 RotatePointAroundZRotation(Vector2 point, TransformComponent transform)
		local radian = math.rad(transform.ZRotation)
		local scale = transform.Scale
		local newPos = Vector2.zero
		newPos.x = math.cos(radian) * point.x * scale.x - math.sin(radian) * point.y * scale.y
		newPos.y = math.sin(radian) * point.x * scale.x + math.cos(radian) * point.y * scale.y

		return newPos
	end

	-- Alpha max plus beta min: approximates Euclidean distance without sqrt (~4% max error), for perf-critical calls (e.g. per-frame AI range checks)
	method number FastDistance(Vector2 a, Vector2 b)
		local dx = a.x - b.x
		local dy = a.y - b.y
		if dx < 0 then dx = -dx end
		if dy < 0 then dy = -dy end

		-- Ensure dx is the larger component (alpha * max + beta * min)
		if dx < dy then
			dx, dy = dy, dx
		end

		return dx * 0.960433870103 + dy * 0.397824734759
	end

	-- Exact squared distance, no sqrt — use when only comparing distances (e.g. nearest-target search) rather than needing the true magnitude
	method number DistanceSquared(Vector2 a, Vector2 b)
		local dx = a.x - b.x
		local dy = a.y - b.y
		return dx * dx + dy * dy
	end

end