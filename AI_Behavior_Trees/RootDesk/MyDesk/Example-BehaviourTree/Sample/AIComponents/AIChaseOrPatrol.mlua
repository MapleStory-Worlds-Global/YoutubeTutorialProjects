-- Sample AI component (extends AIComponent) that drives the ChaseOrPatrol behaviour tree:
-- each frame on the server it looks for a player within DetectionRange and writes it to the
-- "bb_Player" blackboard key (nil when none), which the tree uses to choose chasing vs patrolling.
-- Also draws the detection radius as a translucent circle and flips the sprite to face its movement.
@Component
script AIChaseOrPatrol extends AIComponent

	-- Player detection radius in world units (also the radius of the drawn circle)
	property number DetectionRange = 5.0

	-- Draws the detection-range circle once when the entity starts playing.
	method void OnBeginPlay()
		self:DrawRange()		
	end

	-- Every frame: refresh the detected player on the blackboard and update sprite facing.
	-- Both calls are ServerOnly, so on clients this does nothing.
	method void OnUpdate(number delta)
		self:DetectPlayer()
		self:Flip()
	end

	-- Adds a PolygonRendererComponent and fills it with a 24-point circle of radius
	-- DetectionRange (local to the entity) as a visual debug aid for the detection area.
	@ExecSpace("ServerOnly")
	method void DrawRange()
		 ---@type PolygonRendererComponent
		local polygon = self.Entity:AddComponent("PolygonRendererComponent")
		-- Translucent green (25% alpha)
		polygon.Color = Color(0, 1, 0, 0.25)
		
		-- Number of vertices around the circle; each one is placed at angle 2*pi*i/res
		local res = 24
		local radius = self.DetectionRange
		for i = 1, res do
			local rad = 2 * math.pi * (i / tonumber(res))
			local x = math.cos(rad) * radius
			local y = math.sin(rad) * radius
			polygon.Points:Add(Vector2(x, y))
		end
	end

	-- Scans all connected players and stores one within DetectionRange in the "bb_Player"
	-- blackboard key (or clears it to nil). Runs server-side only.
	@ExecSpace("ServerOnly")
	method void DetectPlayer()
		local target = nil
		local minDist = self.DetectionRange
		local myPos = self.Entity.TransformComponent.WorldPosition:ToVector2()
		
		-- UserEntities maps userId -> player entity
		local users = _UserService.UserEntities
		for userId, user in pairs(users) do
			local userPos = user.TransformComponent.WorldPosition:ToVector2()
			local dist = userPos:Distance(myPos)
			-- Note: the break takes the first player found in range, not necessarily the nearest
			if dist < minDist then
				target = user
				minDist = dist
				break
			end
		end
		
		-- Publish the result for the behaviour tree (nil means no player in range)
		if target == nil then
			self.BlackBoard:SetEntity("bb_Player", nil)
		else
			self.BlackBoard:SetEntity("bb_Player", target)
		end
	end

	-- Flips the sprite to face the horizontal direction of travel, based on the
	-- KinematicbodyComponent's MoveVelocity (FlipX = true when moving right, false when moving left).
	@ExecSpace("ServerOnly")
	method void Flip()
		local rigidbody = self.Entity.KinematicbodyComponent
		local sprite = self.Entity.SpriteRendererComponent
		
		-- Only update facing while actually moving, so the last direction is kept when idle
		if rigidbody.MoveVelocity:Magnitude() > 0 then
			if rigidbody.MoveVelocity.x < 0 then
				sprite.FlipX = false
			else
				sprite.FlipX = true
			end
		end
	end

end