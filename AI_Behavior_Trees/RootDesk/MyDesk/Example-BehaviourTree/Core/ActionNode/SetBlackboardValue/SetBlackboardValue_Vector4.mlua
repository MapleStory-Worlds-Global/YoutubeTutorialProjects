-- Behaviour tree ActionNode that writes a fixed Vector4 value into the owning AI's Blackboard.
-- Configure Key (the Blackboard variable name) and Value on the node; it completes in a single
-- tick, returning Success, or Failure when the node has no parent AIComponent.
@BTNode
script SetBlackboardValue_Vector4 extends ActionNode

	-- Name of the Blackboard variable to write
	property string Key = ""

	-- Vector4 value stored under Key each time the node runs
	property Vector4 Value = Vector4(0.000, 0.000, 0.000, 0.000)

	-- Called each time the tree ticks this node: writes Value to the Blackboard under Key and
	-- returns Success immediately (delta is unused).
	method any OnBehave(number delta)
		local aiComponent = self.ParentAI
		-- Without an owning AIComponent there is no Blackboard to write to
		if aiComponent == nil then
			return BehaviourTreeStatus.Failure
		end
		
		aiComponent.BlackBoard:SetVector4(self.Key, self.Value)
		return BehaviourTreeStatus.Success
	end

end