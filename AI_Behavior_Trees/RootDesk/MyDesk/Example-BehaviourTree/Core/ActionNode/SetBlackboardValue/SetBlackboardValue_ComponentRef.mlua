-- Behaviour tree ActionNode that writes a fixed ComponentRef value into the owning AI's Blackboard.
-- Configure Key (the Blackboard variable name) and Value on the node; it completes in a single
-- tick, returning Success, or Failure when the node has no parent AIComponent.
-- Note: Value and the Blackboard variable should use the same concrete component type.
@BTNode
script SetBlackboardValue_ComponentRef extends ActionNode

	-- Name of the Blackboard variable to write
	property string Key = ""

	-- ComponentRef value stored under Key each time the node runs
	property ComponentRef Value = nil

	-- Called each time the tree ticks this node: writes Value to the Blackboard under Key and
	-- returns Success immediately (delta is unused).
	method any OnBehave(number delta)
		local aiComponent = self.ParentAI
		-- Without an owning AIComponent there is no Blackboard to write to
		if aiComponent == nil then
			return BehaviourTreeStatus.Failure
		end
		
		-- Unlike the other variants, Value is first copied into a local typed as the base
		-- ComponentRef (Value may be configured with a concrete component type) before the call
		---@type ComponentRef
		local upcastValue = self.Value
		aiComponent.BlackBoard:SetComponentRef(self.Key, upcastValue)
		return BehaviourTreeStatus.Success
	end

end