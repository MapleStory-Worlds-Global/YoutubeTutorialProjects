-- Behaviour-tree action node: waits a fixed number of seconds. Returns Running each tick
-- until WaitTime has elapsed, then Success.
@BTNode
script Wait extends ActionNode

	-- Seconds to wait before succeeding
	property number WaitTime = 0.0

	-- Internal timer: seconds accumulated since the node was initialized
	@HideFromInspector
	property number ElapsedTime = 0.0

	-- Called when the node is initialized by the behaviour tree; resets the timer.
	method void OnInit()
		self.ElapsedTime = 0.0
	end

	-- Called each tick while this node is active. Accumulates frame delta into ElapsedTime
	-- and returns Success once WaitTime is reached, otherwise Running.
	method any OnBehave(number delta)
		self.ElapsedTime = self.ElapsedTime + delta
		if self.ElapsedTime >= self.WaitTime then
			return BehaviourTreeStatus.Success
		end
		
		return BehaviourTreeStatus.Running
	end

end