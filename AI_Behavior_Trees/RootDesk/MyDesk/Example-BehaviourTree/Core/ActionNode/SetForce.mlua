-- Behaviour-tree action node: reads a Vector2 force from the AI's blackboard and sets it
-- as the AI entity's RigidbodyComponent force (replaces rather than adds, unlike AddForce).
-- Completes in a single tick: Success once applied, Failure if anything is missing.
@BTNode
script SetForce extends ActionNode

	-- Blackboard key holding the Vector2 force to set
	property string ForceKey = nil

	-- Called each tick while this node is active. Returns Failure if the AI, entity,
	-- rigidbody or blackboard force is missing; otherwise sets the force and returns Success.
	method any OnBehave(number delta)
		local aiComponent = self.ParentAI
		if aiComponent == nil then
			return BehaviourTreeStatus.Failure
		end
		
		local aiEntity = aiComponent.Entity
		if aiEntity == nil then
			return BehaviourTreeStatus.Failure
		end
		
		local rigidbodyComponent = aiEntity.RigidbodyComponent
		if rigidbodyComponent == nil then
			return BehaviourTreeStatus.Failure
		end
		
		local force = aiComponent.BlackBoard:GetVector2(self.ForceKey)
		if force == nil then
			return BehaviourTreeStatus.Failure
		end
		
		rigidbodyComponent:SetForce(force)
		return BehaviourTreeStatus.Success
	end

end