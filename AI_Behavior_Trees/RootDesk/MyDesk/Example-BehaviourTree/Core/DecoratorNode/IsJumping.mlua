-- Behaviour tree DecoratorNode that only runs its child while the AI entity is mid-jump, i.e. it is
-- moving upward or is not on the ground. Otherwise (grounded and not rising) it returns Failure.
-- Requires a RigidbodyComponent on the AI entity.
@BTNode
script IsJumping extends DecoratorNode

	-- Called each tick: returns Failure (without ticking the child) when there is no rigidbody or the
	-- entity is grounded and not rising; otherwise ticks the child and returns its result.
	method any OnBehave(number delta)
		local rigidbody = self.ParentAI.Entity.RigidbodyComponent
		-- The jump check needs the entity's RigidbodyComponent
		if rigidbody == nil then
			return BehaviourTreeStatus.Failure
		end
		
		-- Not jumping = not moving upward (RealMoveVelocity.y <= 0) AND standing on the ground
		if rigidbody.RealMoveVelocity.y <= 0 and rigidbody:IsOnGround()then
			return BehaviourTreeStatus.Failure
		end
		
		return self:ChildBehave(delta)
	end

end